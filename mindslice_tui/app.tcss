* {
    scrollbar-size-vertical: 1;
    scrollbar-color: $foreground 20%;
    scrollbar-color-hover: $foreground 40%;
    scrollbar-color-active: $accent;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
}

#slices, #card, #relations {
    border: round $primary-darken-1;
    border-title-color: $text;
}

#slices:focus, #card:focus-within, #relations:focus-within {
    border: round $accent;
}

#slices {
    width: 38;
}

#card {
    width: 1fr;
    padding: 0 1;
}

#relations {
    width: 46;
}

/* Names come first in the relation rows, so clipping the dim folder beats a scrollbar. */
#relations Tree {
    overflow-x: hidden;
}

Table DataTable {
    height: 1fr;
}

#card-meta {
    border-bottom: solid $primary-darken-1;
    margin-bottom: 1;
}

/* Full text of the highlighted relation or table row. */
#preview, .detail {
    height: auto;
    max-height: 8;
    padding: 0 1;
    border-top: solid $primary-darken-1;
}

Markdown {
    padding: 0;
}

ModalScreen {
    align: center middle;
}

.dialog {
    width: 90%;
    height: 85%;
    border: round $accent;
    background: $surface;
    padding: 0 1;
}

.dialog OptionList {
    height: 1fr;
    border: none;
}

#search-note {
    color: $text-muted;
}

/* Review and bake: the list beside the highlighted change, the outcome under both. */
.checklist {
    height: 1fr;
}

.checklist DataTable {
    width: 3fr;
    height: 1fr;
}

.checklist VerticalScroll {
    width: 2fr;
    padding: 0 1;
    border-left: solid $primary-darken-1;
}

#outcome {
    height: auto;
    max-height: 10;
    padding: 0 1;
    border-top: solid $primary-darken-1;
}

/* Small boxes over a checklist: a yes/no question, a destination prompt. */
.prompt {
    width: 72;
    height: auto;
    border: round $warning;
    background: $surface;
    padding: 1 2;
}

.prompt OptionList {
    height: auto;
    max-height: 12;
    border: none;
    margin-bottom: 1;
}
